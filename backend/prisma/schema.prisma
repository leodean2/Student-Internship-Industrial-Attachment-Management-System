generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id                             String                          @id @default(uuid())
  email                          String                          @unique
  passwordHash                   String
  name                           String
  status                         UserStatus                      @default(PENDING_VERIFICATION)
  emailVerifiedAt                DateTime?
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
  adminProfile                   AdminProfile?
  applicationsCreated            AttachmentApplication[]         @relation("ApplicationCreatedBy")
  applicationsReviewed           AttachmentApplication[]         @relation("ApplicationReviewedBy")
  auditLogEntries                AuditLog[]                      @relation("AuditActor")
  documentVersionsUploaded       DocumentVersion[]               @relation("DocumentVersionUploadedBy")
  emailOutboxEntries             EmailOutbox[]                   @relation("EmailOutboxRelatedUser")
  emailVerificationTokens        EmailVerificationToken[]
  finalEvaluationsPerformed      FinalEvaluation[]               @relation("FinalEvalPerformedBy")
  industryEvaluationsSubmitted   IndustryEvaluation[]            @relation("IndustryEvalSubmittedBy")
  invitationAccepted             Invitation?                     @relation("InvitationAcceptedBy")
  invitationsSent                Invitation[]                    @relation("InvitationInvitedBy")
  notifications                  Notification[]                  @relation("NotificationRecipient")
  organizationSupervisorProfiles OrganizationSupervisorProfile[]
  organizationsApproved          Organization[]                  @relation("OrganizationApprovedBy")
  organizationsProposed          Organization[]                  @relation("OrganizationProposedBy")
  passwordResetTokens            PasswordResetToken[]
  registrationReviewerAssignments RegistrationReviewer[]           @relation("ReviewerAssignee")
  registrationReviewersGranted    RegistrationReviewer[]           @relation("ReviewerGrantedBy")
  registrationReviewersRevoked    RegistrationReviewer[]           @relation("ReviewerRevokedBy")
  rosterImports                  StudentRosterImport[]             @relation("RosterImportedBy")
  refreshTokens                  RefreshToken[]
  studentProfile                 StudentProfile?                 @relation("StudentProfileOwner")
  registrationDecisionsMade     StudentProfile[]                 @relation("RegistrationDecidedBy")
  supervisionVisitsConducted     SupervisionVisit[]              @relation("VisitConductedBy")
  terminationsCleared            TerminationRecord[]             @relation("TerminationClearanceGrantedBy")
  terminationsInitiated          TerminationRecord[]             @relation("TerminationInitiatedBy")
  universitySupervisorProfile    UniversitySupervisorProfile?
  roles                          UserRole[]
  weeklyLogsVerified             WeeklyLog[]                     @relation("WeeklyLogOrgVerifiedBy")
  weeklyLogsReviewed             WeeklyLog[]                     @relation("WeeklyLogReviewedBy")

  @@map("users")
}

model UserRole {
  id     String       @id @default(uuid())
  userId String
  role   UserRoleName
  user   User         @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@unique([userId, role])
  @@map("user_roles")
}

model StudentProfile {
  id                          String             @id @default(uuid())
  userId                      String             @unique
  registrationNumber          String?            @unique
  registrationStatus          RegistrationStatus @default(PENDING)
  registrationDepartmentCode  String
  rejectedRegistrationNumber  String?
  registrationDecidedAt       DateTime?
  registrationDecidedByUserId String?
  registrationDecisionBasis   String?
  registrationDecisionReason  String?
  university                  String?
  course                      String?
  faculty                     String?
  department                  String?
  yearOfStudy                 Int?
  phone                       String?
  expectedGraduation          DateTime?
  applications                AttachmentApplication[]
  attachments                 Attachment[]
  user                        User               @relation("StudentProfileOwner", fields: [userId], references: [id], onUpdate: NoAction)
  registrationDecidedBy       User?              @relation("RegistrationDecidedBy", fields: [registrationDecidedByUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([registrationStatus, registrationDepartmentCode])
  @@map("student_profiles")
}

model UniversitySupervisorProfile {
  id          String       @id @default(uuid())
  userId      String       @unique
  staffId     String?
  title       String?
  attachments Attachment[]
  user        User         @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@map("university_supervisor_profiles")
}

model OrganizationSupervisorProfile {
  id                  String                  @id @default(uuid())
  userId              String
  organizationId      String
  claimedApplications AttachmentApplication[]
  attachments         Attachment[]
  organization        Organization            @relation(fields: [organizationId], references: [id], onUpdate: NoAction)
  user                User                    @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@unique([userId, organizationId])
  @@map("organization_supervisor_profiles")
}

model AdminProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@map("admin_profiles")
}

model RegistrationReviewer {
  id              String    @id @default(uuid())
  userId          String
  departmentCode  String
  grantedByUserId String
  grantedAt       DateTime  @default(now())
  revokedAt       DateTime?
  revokedByUserId String?
  user            User      @relation("ReviewerAssignee", fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  grantedBy       User      @relation("ReviewerGrantedBy", fields: [grantedByUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  revokedBy       User?     @relation("ReviewerRevokedBy", fields: [revokedByUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([userId])
  @@map("registration_reviewers")
}

model StudentRosterImport {
  id               String               @id @default(uuid())
  importedByUserId String
  importedAt       DateTime             @default(now())
  fileSha256       String
  rowCount         Int
  insertedCount    Int
  skippedCount     Int
  conflictCount    Int
  invalidCount     Int
  duplicateCount   Int
  importedBy       User                 @relation("RosterImportedBy", fields: [importedByUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  entries          StudentRosterEntry[]

  @@index([importedAt])
  @@map("student_roster_imports")
}

model StudentRosterEntry {
  id                 String              @id @default(uuid())
  registrationNumber String              @unique
  departmentCode     String
  studentName        String?
  rosterStatus       String?
  importId           String
  firstImport        StudentRosterImport @relation(fields: [importId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([departmentCode])
  @@map("student_roster_entries")
}

model RefreshToken {
  id               String        @id @default(uuid())
  userId           String
  tokenHash        String        @unique
  issuedAt         DateTime      @default(now())
  expiresAt        DateTime
  sessionExpiresAt DateTime
  revokedAt        DateTime?
  replacedById     String?       @unique
  replacedBy       RefreshToken? @relation("TokenRotation", fields: [replacedById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  replaces         RefreshToken? @relation("TokenRotation")
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("email_verification_tokens")
}

model Invitation {
  id               String        @id @default(uuid())
  email            String
  role             UserRoleName
  organizationId   String?
  invitedByUserId  String
  tokenHash        String        @unique
  expiresAt        DateTime
  acceptedByUserId String?       @unique
  createdAt        DateTime      @default(now())
  acceptedAt       DateTime?
  revokedAt        DateTime?
  acceptedByUser   User?         @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  invitedBy        User          @relation("InvitationInvitedBy", fields: [invitedByUserId], references: [id], onUpdate: NoAction)
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([createdAt, id])
  @@map("invitations")
}

model Organization {
  id                 String                          @id @default(uuid())
  name               String
  status             OrganizationStatus              @default(PENDING)
  proposedByUserId   String
  approvedByUserId   String?
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt
  applications       AttachmentApplication[]
  attachments        Attachment[]
  invitations        Invitation[]
  supervisorProfiles OrganizationSupervisorProfile[]
  approvedBy         User?                           @relation("OrganizationApprovedBy", fields: [approvedByUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  proposedBy         User                            @relation("OrganizationProposedBy", fields: [proposedByUserId], references: [id], onUpdate: NoAction)

  @@map("organizations")
}

model AttachmentApplication {
  id                    String                         @id @default(uuid())
  studentId             String
  organizationId        String
  status                ApplicationStatus              @default(DRAFT)
  createdById           String
  reviewedById          String?
  reviewedAt            DateTime?
  rejectionReason       String?
  claimedBySupervisorId String?
  claimedAt             DateTime?
  declineReason         String?
  studentAcknowledgedAt DateTime?
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt
  claimedBy             OrganizationSupervisorProfile? @relation(fields: [claimedBySupervisorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdBy             User                           @relation("ApplicationCreatedBy", fields: [createdById], references: [id], onUpdate: NoAction)
  organization          Organization                   @relation(fields: [organizationId], references: [id], onUpdate: NoAction)
  reviewedBy            User?                          @relation("ApplicationReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  student               StudentProfile                 @relation(fields: [studentId], references: [id], onUpdate: NoAction)
  attachment            Attachment?
  documents             Document[]

  @@map("attachment_applications")
}

model Attachment {
  id                        String                        @id @default(uuid())
  applicationId             String                        @unique
  studentId                 String
  organizationId            String
  organizationSupervisorId  String
  universitySupervisorId    String?
  status                    AttachmentStatus              @default(CONFIRMED)
  outcome                   AttachmentOutcome?
  startDate                 DateTime
  endDate                   DateTime
  reportingPeriodLengthDays Int
  previousAttachmentId      String?                       @unique
  createdAt                 DateTime                      @default(now())
  updatedAt                 DateTime                      @updatedAt
  application               AttachmentApplication         @relation(fields: [applicationId], references: [id], onUpdate: NoAction)
  organization              Organization                  @relation(fields: [organizationId], references: [id], onUpdate: NoAction)
  organizationSupervisor    OrganizationSupervisorProfile @relation(fields: [organizationSupervisorId], references: [id], onUpdate: NoAction)
  previousAttachment        Attachment?                   @relation("AttachmentProvenance", fields: [previousAttachmentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  nextAttachment            Attachment?                   @relation("AttachmentProvenance")
  student                   StudentProfile                @relation(fields: [studentId], references: [id], onUpdate: NoAction)
  universitySupervisor      UniversitySupervisorProfile?  @relation(fields: [universitySupervisorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  documents                 Document[]
  finalEvaluations          FinalEvaluation[]
  industryEvaluation        IndustryEvaluation?
  supervisionVisits         SupervisionVisit[]
  terminationRecord         TerminationRecord?
  weeklyLogs                WeeklyLog[]

  @@map("attachments")
}

model TerminationReasonCategory {
  id                                     String              @id @default(uuid())
  code                                   String              @unique
  name                                   String
  requiresAdminClearanceForReapplication Boolean             @default(false)
  isActive                               Boolean             @default(true)
  terminationRecords                     TerminationRecord[]

  @@map("termination_reason_categories")
}

model TerminationRecord {
  id                        String                    @id @default(uuid())
  attachmentId              String                    @unique
  reasonCategoryId          String
  initiatedByUserId         String
  initiatedByType           TerminationInitiator
  reasonDescription         String
  terminatedAt              DateTime                  @default(now())
  clearanceGrantedAt        DateTime?
  clearanceGrantedByAdminId String?
  attachment                Attachment                @relation(fields: [attachmentId], references: [id], onUpdate: NoAction)
  clearanceGrantedByAdmin   User?                     @relation("TerminationClearanceGrantedBy", fields: [clearanceGrantedByAdminId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  initiatedBy               User                      @relation("TerminationInitiatedBy", fields: [initiatedByUserId], references: [id], onUpdate: NoAction)
  reasonCategory            TerminationReasonCategory @relation(fields: [reasonCategoryId], references: [id], onUpdate: NoAction)

  @@map("termination_records")
}

model ReportingScheduleConfig {
  id               Int      @id @default(1)
  periodLengthDays Int      @default(7)
  updatedAt        DateTime @updatedAt

  @@map("reporting_schedule_config")
}

model WeeklyLog {
  id                String             @id @default(uuid())
  attachmentId      String
  periodNumber      Int
  activities        String
  skillsLearned     String?
  challenges        String?
  reflection        String?
  status            WeeklyLogStatus    @default(DRAFT)
  reviewedById      String?
  revisionComment   String?
  orgVerifiedAt     DateTime?
  orgVerifiedBy     String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  versions          WeeklyLogVersion[]
  attachment        Attachment         @relation(fields: [attachmentId], references: [id], onUpdate: NoAction)
  orgVerifiedByUser User?              @relation("WeeklyLogOrgVerifiedBy", fields: [orgVerifiedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reviewedByUser    User?              @relation("WeeklyLogReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([attachmentId, periodNumber])
  @@map("weekly_logs")
}

model WeeklyLogVersion {
  id            String    @id @default(uuid())
  weeklyLogId   String
  versionNumber Int
  activities    String
  skillsLearned String?
  challenges    String?
  reflection    String?
  savedAt       DateTime  @default(now())
  weeklyLog     WeeklyLog @relation(fields: [weeklyLogId], references: [id], onUpdate: NoAction)

  @@unique([weeklyLogId, versionNumber])
  @@map("weekly_log_versions")
}

model SupervisionVisit {
  id                       String     @id @default(uuid())
  attachmentId             String
  universitySupervisorId   String
  visitDate                DateTime
  visitType                String?
  summary                  String
  observations             String
  recommendations          String
  studentAcknowledgedAt    DateTime?
  studentComment           String?
  createdAt                DateTime   @default(now())
  attachment               Attachment @relation(fields: [attachmentId], references: [id], onUpdate: NoAction)
  universitySupervisorUser User       @relation("VisitConductedBy", fields: [universitySupervisorId], references: [id], onUpdate: NoAction)

  @@map("supervision_visits")
}

model EvaluationCriterion {
  id              String                     @id @default(uuid())
  name            String
  weight          Decimal                    @db.Decimal(5, 2)
  isActive        Boolean                    @default(true)
  sortOrder       Int                        @default(0)
  finalRatings    FinalEvaluationRating[]
  industryRatings IndustryEvaluationRating[]

  @@map("evaluation_criteria")
}

model IndustryEvaluation {
  id                String                      @id @default(uuid())
  attachmentId      String                      @unique
  submittedByUserId String
  isLocked          Boolean                     @default(false)
  lockedAt          DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  ratings           IndustryEvaluationRating[]
  versions          IndustryEvaluationVersion[]
  attachment        Attachment                  @relation(fields: [attachmentId], references: [id], onUpdate: NoAction)
  submittedBy       User                        @relation("IndustryEvalSubmittedBy", fields: [submittedByUserId], references: [id], onUpdate: NoAction)

  @@map("industry_evaluations")
}

model IndustryEvaluationRating {
  id                   String              @id @default(uuid())
  industryEvaluationId String
  criterionId          String
  rating               Int
  comment              String?
  criterion            EvaluationCriterion @relation(fields: [criterionId], references: [id], onUpdate: NoAction)
  industryEvaluation   IndustryEvaluation  @relation(fields: [industryEvaluationId], references: [id], onUpdate: NoAction)

  @@unique([industryEvaluationId, criterionId])
  @@map("industry_evaluation_ratings")
}

model IndustryEvaluationVersion {
  id                     String             @id @default(uuid())
  industryEvaluationId   String
  versionNumber          Int
  snapshot               Json
  savedAt                DateTime           @default(now())
  usedByFinalEvaluations FinalEvaluation[]
  industryEvaluation     IndustryEvaluation @relation(fields: [industryEvaluationId], references: [id], onUpdate: NoAction)

  @@unique([industryEvaluationId, versionNumber])
  @@map("industry_evaluation_versions")
}

model FinalEvaluation {
  id                              String                     @id @default(uuid())
  attachmentId                    String
  universitySupervisorId          String
  status                          FinalEvaluationStatus      @default(DRAFT)
  overallScore                    Decimal?                   @db.Decimal(5, 2)
  outcome                         AttachmentOutcome?
  finalizedAt                     DateTime?
  supersededAt                    DateTime?
  supersededByFinalEvaluationId   String?                    @unique
  industryEvaluationVersionIdUsed String?
  createdAt                       DateTime                   @default(now())
  updatedAt                       DateTime                   @updatedAt
  ratings                         FinalEvaluationRating[]
  attachment                      Attachment                 @relation(fields: [attachmentId], references: [id], onUpdate: NoAction)
  industryEvaluationVersionUsed   IndustryEvaluationVersion? @relation(fields: [industryEvaluationVersionIdUsed], references: [id], onDelete: Restrict, onUpdate: NoAction)
  supersededBy                    FinalEvaluation?           @relation("EvaluationSupersession", fields: [supersededByFinalEvaluationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  supersedes                      FinalEvaluation?           @relation("EvaluationSupersession")
  universitySupervisorUser        User                       @relation("FinalEvalPerformedBy", fields: [universitySupervisorId], references: [id], onUpdate: NoAction)

  @@map("final_evaluations")
}

model FinalEvaluationRating {
  id                String              @id @default(uuid())
  finalEvaluationId String
  criterionId       String
  rating            Int
  comment           String?
  criterion         EvaluationCriterion @relation(fields: [criterionId], references: [id], onUpdate: NoAction)
  finalEvaluation   FinalEvaluation     @relation(fields: [finalEvaluationId], references: [id], onUpdate: NoAction)

  @@unique([finalEvaluationId, criterionId])
  @@map("final_evaluation_ratings")
}

model DocumentTypeConfig {
  id         String           @id @default(uuid())
  category   DocumentCategory
  code       String
  name       String
  isRequired Boolean          @default(false)
  isActive   Boolean          @default(true)
  documents  Document[]

  @@unique([category, code])
  @@map("document_type_configs")
}

model Document {
  id                      String                 @id @default(uuid())
  attachmentApplicationId String?
  attachmentId            String?
  documentTypeId          String
  createdAt               DateTime               @default(now())
  versions                DocumentVersion[]
  attachmentApplication   AttachmentApplication? @relation(fields: [attachmentApplicationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  attachment              Attachment?            @relation(fields: [attachmentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  documentType            DocumentTypeConfig     @relation(fields: [documentTypeId], references: [id], onUpdate: NoAction)

  @@map("documents")
}

model DocumentVersion {
  id               String   @id @default(uuid())
  documentId       String
  versionNumber    Int
  storageKey       String   @unique
  originalFilename String
  mimeType         String
  sizeBytes        BigInt
  sha256           String
  uploadedByUserId String
  uploadedAt       DateTime @default(now())
  isCurrent        Boolean  @default(true)
  document         Document @relation(fields: [documentId], references: [id], onUpdate: NoAction)
  uploadedBy       User     @relation("DocumentVersionUploadedBy", fields: [uploadedByUserId], references: [id], onUpdate: NoAction)

  @@unique([documentId, versionNumber])
  @@map("document_versions")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String
  action      String
  targetType  String
  targetId    String
  metadata    Json?
  occurredAt  DateTime @default(now())
  actor       User     @relation("AuditActor", fields: [actorUserId], references: [id], onUpdate: NoAction)

  @@index([targetType, targetId])
  @@map("audit_logs")
}

model Notification {
  id                String    @id @default(uuid())
  recipientUserId   String
  type              String
  title             String
  message           String
  relatedEntityType String?
  relatedEntityId   String?
  readAt            DateTime?
  createdAt         DateTime  @default(now())
  recipient         User      @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onUpdate: NoAction)

  @@map("notifications")
}

model EmailOutbox {
  id                  String            @id @default(uuid())
  toEmail             String
  relatedUserId       String?
  templateType        String
  payload             Json?
  status              EmailOutboxStatus @default(PENDING)
  attempts            Int               @default(0)
  nextAttemptAt       DateTime?
  processingStartedAt DateTime?
  claimToken          String?
  leaseExpiresAt      DateTime?
  sentAt              DateTime?
  idempotencyKey      String            @unique
  createdAt           DateTime          @default(now())
  relatedUser         User?             @relation("EmailOutboxRelatedUser", fields: [relatedUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("email_outbox")
}

model JobRun {
  id             String       @id @default(uuid())
  jobName        String
  startedAt      DateTime
  finishedAt     DateTime?
  itemsProcessed Int          @default(0)
  itemsFailed    Int          @default(0)
  status         JobRunStatus

  @@map("job_runs")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  DEACTIVATED
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum UserRoleName {
  STUDENT
  UNIVERSITY_SUPERVISOR
  ORGANIZATION_SUPERVISOR
  ADMIN
}

enum OrganizationStatus {
  PENDING
  APPROVED
  ACTIVE
  SUSPENDED
}

enum ApplicationStatus {
  ADMIN_CREATED
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  CLAIMED
  ACCEPTED
  REJECTED
  DECLINED
  CANCELLED
}

enum AttachmentStatus {
  CONFIRMED
  ACTIVE
  COMPLETION_PENDING
  COMPLETED
  ENDED_EARLY
}

enum AttachmentOutcome {
  SATISFACTORY
  UNSATISFACTORY
  INCOMPLETE
}

enum TerminationInitiator {
  STUDENT
  ORGANIZATION
  UNIVERSITY
}

enum WeeklyLogStatus {
  DRAFT
  SUBMITTED
  NEEDS_REVISION
  REVIEWED
}

enum FinalEvaluationStatus {
  DRAFT
  FINALIZED
}

enum DocumentCategory {
  APPLICATION_SUPPORTING
  ATTACHMENT_PERIOD
}

enum EmailOutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum JobRunStatus {
  RUNNING
  SUCCESS
  PARTIAL_FAILURE
  FAILED
}
