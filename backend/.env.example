NODE_ENV=development
PORT=4000
# Direct (non-pooled) URL for Prisma migrations; Neon env pull supplies this automatically.
DATABASE_URL_UNPOOLED=postgresql://localhost:5432/attachment_dev
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/attachment_dev
# Must be a long random value (>= 32 chars). Never commit the real one.
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
# Comma-separated list of allowed browser origins (strict allow-list, Decision #55)
CORS_ORIGIN=http://localhost:5173
# Frontend origin used to construct invitation acceptance links; production must use HTTPS.
APP_BASE_URL=http://localhost:5173
# strict is the default (Decision #55). Use lax/none only if the SPA and API are on different sites (see README).
REFRESH_COOKIE_SAMESITE=strict
# Failed email-verification token guesses per IP and the sliding-window duration.
EMAIL_VERIFY_FAILED_ATTEMPT_LIMIT=10
EMAIL_VERIFY_WINDOW_MS=900000
LOG_LEVEL=info
# Reverse proxies in front of the API. 0 locally; 1 on Render. Wrong values weaken login throttling.
TRUST_PROXY_HOPS=0
# Per-email password-reset request limit per hour (C2 decision). Default: 3.
PASSWORD_RESET_EMAIL_LIMIT_PER_HOUR=3
# Optional stable secret (>= 32 chars) for HMAC throttle-key hashing. Unset = random per-process (right for in-memory store).
# THROTTLE_KEY_SECRET=

# Email outbox worker (Decision #54). All optional; defaults shown.
EMAIL_PROVIDER=log
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM=
WORKER_POLL_INTERVAL_MS=5000
WORKER_BATCH_SIZE=10
WORKER_CONCURRENCY=5
WORKER_LEASE_DURATION_MS=60000
WORKER_LEASE_RENEWAL_INTERVAL_MS=20000
WORKER_PROVIDER_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=90000
