NODE_ENV=development
PORT=4000
# Direct (non-pooled) URL for Prisma migrations; Neon env pull supplies this automatically.
DATABASE_URL_UNPOOLED=postgresql://localhost:5432/attachment_dev
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/attachment_dev
# Must be a long random value (>= 32 chars). Never commit the real one.
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
# Comma-separated list of allowed browser origins (strict allow-list, Decision #55)
CORS_ORIGIN=http://localhost:5173
# strict is the default (Decision #55). Use lax/none only if the SPA and API are on different sites (see README).
REFRESH_COOKIE_SAMESITE=strict
LOG_LEVEL=info
